#!/usr/bin/env bash
# SPDX-License-Identifier: CC-BY-NC-SA-4.0
set -euo pipefail
cd "$(dirname "$0")/.."

sanitizer=${1:-address}
case "$sanitizer" in
  address|thread|leak) ;;
  *) echo "usage: scripts/kagi-sanitize [address|thread|leak]" >&2; exit 2 ;;
esac

target=${KAGI_SANITIZER_TARGET:-x86_64-unknown-linux-gnu}
rustup component add rust-src --toolchain nightly >/dev/null
export RUSTFLAGS="${RUSTFLAGS:-} -Zsanitizer=$sanitizer -C debuginfo=1"
export RUSTDOCFLAGS="${RUSTDOCFLAGS:-} -Zsanitizer=$sanitizer"

# build-std instruments the standard library as well as Kagi. Keep this to the
# reusable compute library: daemon integration exercises sockets/kernel APIs that
# are better covered by fuzz/integration tests than by sanitizer emulation.
cargo +nightly test   -Zbuild-std   --target "$target"   --lib   --no-default-features
