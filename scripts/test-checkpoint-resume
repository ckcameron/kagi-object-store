#!/usr/bin/env python3
# SPDX-License-Identifier: CC-BY-NC-SA-4.0
"""Interrupt a real planner process, then compare resumed and cold saved runs."""
import argparse
import pathlib
import shutil
import subprocess
import tempfile
import time

parser = argparse.ArgumentParser()
parser.add_argument("binary", type=pathlib.Path)
args = parser.parse_args()
binary = args.binary.resolve()
project = pathlib.Path(__file__).resolve().parent.parent
with tempfile.TemporaryDirectory(prefix="kagi-resume-test-") as directory:
    root = pathlib.Path(directory)
    saved = root / "saved"
    output = root / "result.yaml"
    key = root / "join.key"
    command = [str(binary), "--config", str(project / "examples/example.yaml"),
               "--trials", "256", "--rare-trials", "256", "--time-trials", "128",
               "--candidates", "4", "--finalists", "2", "--validation-keys", "2",
               "--ais-rounds", "1", "--no-progress", "--checkpoint", str(saved),
               "--checkpoint-seconds", "1", "--checkpoint-batch-trials", "32",
               "--output", output.name, "--join-key-output", key.name]
    with (root / "run.log").open("wb") as log:
        process = subprocess.Popen(command, cwd=root, stdout=log, stderr=log)
        try:
            deadline = time.monotonic() + 120
            while not list((saved / "batches").glob("*.json")):
                if process.poll() is not None:
                    raise RuntimeError("run exited before interruption: " + (root / "run.log").read_text())
                if time.monotonic() > deadline:
                    raise RuntimeError("no committed checkpoint within 120 seconds")
                time.sleep(0.02)
            process.kill()
            process.wait(timeout=10)
        finally:
            if process.poll() is None:
                process.kill()
                process.wait()
    committed = {p.name: p.read_bytes() for p in (saved / "batches").glob("*.json")}
    print(f"Interrupted with {len(committed)} committed batches")

    elsewhere = root / "different-directory"
    elsewhere.mkdir()

    def resume(path, success=True, extra=()):
        result = subprocess.run([str(binary), "--resume", str(path), "--no-progress", *extra],
                                cwd=elsewhere, capture_output=True, timeout=180)
        if success and result.returncode:
            raise RuntimeError(result.stderr.decode())
        if not success and not result.returncode:
            raise RuntimeError("invalid resume unexpectedly succeeded")

    resume(saved)
    expected, expected_key = output.read_bytes(), key.read_bytes()
    for name, content in committed.items():
        assert (saved / "batches" / name).read_bytes() == content
    cold = root / "cold"
    cold.mkdir()
    shutil.copy2(saved / "run.json", cold / "run.json")
    resume(cold)
    assert output.read_bytes() == expected, "resumed and cold results differ"
    assert key.read_bytes() == expected_key, "admission key changed"
    resume(saved, success=False, extra=("--trials", "1"))
    next((cold / "batches").glob("*.json")).write_text("corrupt")
    resume(cold, success=False)
    print("PASS: interruption/resume equals cold run; key stable; committed batches retained; conflicts and corruption rejected")
