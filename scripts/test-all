#!/usr/bin/env bash
# SPDX-License-Identifier: CC-BY-NC-SA-4.0
# Copyright (c) 2026 CK Cameron. Licensed under CC BY-NC-SA 4.0.
set -euo pipefail
cd "$(dirname "$0")/.."

# The default suite validates formatting, all targets, unit tests, and Clippy.
# STRICT=1 additionally promotes every compiler/Clippy warning to an error; this
# is useful for release CI once compatibility-only/deferred frontends are clean.
cargo fmt --all -- --check
cargo check --all-targets
cargo test --all-targets
if [[ "${STRICT:-0}" == "1" ]]; then
  cargo clippy --all-targets -- -D warnings
else
  cargo clippy --all-targets
fi

# Compile and test the userspace loader without attaching privileged kernel hooks.
if [[ "$(uname -s)" == "Linux" ]]; then
  cargo check --all-targets --features ebpf
  cargo test --all-targets --features ebpf
  cargo clippy --all-targets --features ebpf -- -D warnings
fi

# CPU vendor libraries are runtime-loaded, so their feature integration can be
# compiled/tested even when the vendor shared objects are not installed.
if [[ "$(uname -s)" == "Linux" ]]; then
  cargo check --all-targets --features isa-l,ipp,aocl
  cargo test --all-targets --features isa-l,ipp,aocl
  cargo clippy --all-targets --features isa-l,ipp,aocl -- -D warnings
fi

# GPU integrations are compiled whenever the matching development toolchain is
# present. Execution without a device is allowed here; the dedicated
# hardware-execution workflow is the positive-execution gate.
if command -v nvcc >/dev/null 2>&1; then
  cargo check --all-targets --features cuda
  cargo test --all-targets --features cuda
  cargo clippy --all-targets --features cuda -- -D warnings
else
  echo "nvcc not found; CUDA feature validation skipped" >&2
fi

hipcc="${ROCM_PATH:-/opt/rocm}/bin/hipcc"
if [[ -x "$hipcc" ]]; then
  cargo check --all-targets --features hip
  cargo test --all-targets --features hip
  cargo clippy --all-targets --features hip -- -D warnings
else
  echo "hipcc not found; HIP/ROCm feature validation skipped" >&2
fi

if [[ -r /usr/include/CL/cl.h ]] && ldconfig -p 2>/dev/null | grep -q 'libOpenCL\\.so'; then
  cargo check --all-targets --features opencl
  cargo test --all-targets --features opencl
  cargo clippy --all-targets --features opencl -- -D warnings
else
  echo "OpenCL development headers/runtime not found; OpenCL feature validation skipped" >&2
fi
