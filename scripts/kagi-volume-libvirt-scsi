set -euo pipefail
# Generate libvirt XML. Attach the returned disk plus the requested controller.
MODE="${1:?usage: kagi-volume-libvirt-scsi virtio-scsi|sas nbd-host nbd-port [target]}"; HOST="$2"; PORT="$3"; TARGET="${4:-sda}"
case "$MODE" in
 virtio-scsi) MODEL=virtio-scsi;;
 sas) MODEL=lsisas1068;;
 *) echo "mode must be virtio-scsi or sas" >&2; exit 2;;
esac
cat <<XML
<controller type='scsi' index='0' model='$MODEL'/>
<disk type='network' device='disk'>
  <driver name='qemu' type='raw' cache='none' io='native' discard='unmap'/>
  <source protocol='nbd' name='keyspace'><host name='$HOST' port='$PORT'/></source>
  <target dev='$TARGET' bus='scsi'/>
</disk>
XML
