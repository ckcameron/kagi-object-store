#!/usr/bin/env bash
# SPDX-License-Identifier: CC-BY-NC-SA-4.0
# Run on an NVIDIA host with CUDA and compute-sanitizer installed.
set -euo pipefail
cd "$(dirname "$0")/.."

command -v compute-sanitizer >/dev/null 2>&1 || {
  echo "compute-sanitizer is required (NVIDIA CUDA toolkit)." >&2
  exit 2
}

KAGI_CPU_TARGET=${KAGI_CPU_TARGET:-native} scripts/kagi-build --features cuda --bin kagi-bench
args=(--backend cuda --scheme all --sizes 8MiB --iterations 2 --gpu-threshold-bytes 0 --require-acceleration)

echo "== CUDA memory access / API validation =="
compute-sanitizer --tool memcheck target/release/kagi-bench "${args[@]}"

echo "== CUDA race checking =="
compute-sanitizer --tool racecheck target/release/kagi-bench "${args[@]}"

echo "== CUDA initialization checking =="
compute-sanitizer --tool initcheck target/release/kagi-bench "${args[@]}"

echo "== CUDA synchronization checking =="
compute-sanitizer --tool synccheck target/release/kagi-bench "${args[@]}"
