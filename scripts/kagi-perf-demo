#!/usr/bin/env bash
# SPDX-License-Identifier: CC-BY-NC-SA-4.0
# Build a native-optimized Kagi benchmark binary and capture reproducible JSON
# plus optional Linux perf counters.
set -euo pipefail
cd "$(dirname "$0")/.."

stamp=$(date -u +%Y%m%dT%H%M%SZ)
out=${1:-validation/performance/$stamp}
mkdir -p "$out"

features=${KAGI_BENCH_FEATURES:-}
build_args=(--bin kagi-bench)
if [[ -n "$features" ]]; then
  build_args+=(--features "$features")
fi

KAGI_CPU_TARGET=${KAGI_CPU_TARGET:-native} scripts/kagi-build "${build_args[@]}"

backend=${KAGI_BENCH_BACKEND:-auto}
sizes=${KAGI_BENCH_SIZES:-1MiB,8MiB,64MiB}
iterations=${KAGI_BENCH_ITERATIONS:-5}

target/release/kagi-bench   --backend "$backend"   --scheme all   --sizes "$sizes"   --iterations "$iterations"   --json "$out/kagi-bench.json"   | tee "$out/kagi-bench.txt"

if command -v perf >/dev/null 2>&1; then
  perf stat -d -r 3     -o "$out/perf-stat.txt"     target/release/kagi-bench       --backend "$backend"       --scheme clay       --sizes "${KAGI_PERF_SIZE:-64MiB}"       --iterations "${KAGI_PERF_ITERATIONS:-3}"       >/dev/null
else
  echo "perf not installed; hardware-counter collection skipped." | tee "$out/perf-stat.txt"
fi

# Criterion is intentionally separate: it is slower but gives statistical
# baselines and HTML reports under target/criterion.
cargo bench --bench erasure | tee "$out/criterion.txt"

printf 'Kagi performance report: %s\n' "$out"
