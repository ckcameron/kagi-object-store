#!/usr/bin/env bash
# SPDX-License-Identifier: CC-BY-NC-SA-4.0
# Generate a post-quantum Kagi HTTPS identity.  This intentionally fails instead
# of silently falling back to a classical certificate when ML-DSA-87 is missing.
set -euo pipefail

out=${1:-/etc/kagi/tls}
name=${KAGI_TLS_NAME:-kagi.local}
days=${KAGI_TLS_DAYS:-825}
san=${KAGI_TLS_SAN:-DNS:${name}}

command -v openssl >/dev/null 2>&1 || {
  echo "OpenSSL is required to generate the Kagi TLS identity." >&2
  exit 2
}

if ! openssl list -signature-algorithms 2>/dev/null | grep -Eq 'ML[-_]DSA[-_]87|ML-DSA-87'; then
  cat >&2 <<'EOF'
This OpenSSL build does not advertise ML-DSA-87.
Kagi will not substitute an RSA/ECDSA certificate and call it post-quantum.
Install an OpenSSL build with ML-DSA support (OpenSSL 3.5 or compatible)
or provide an externally generated ML-DSA-87 certificate and PKCS#8 key.
EOF
  exit 2
fi

install -d -m 0700 "$out"
umask 077
key="$out/server-key.pem"
cert="$out/server-cert.pem"

openssl genpkey -algorithm ML-DSA-87 -out "$key"
openssl req -new -x509   -key "$key"   -out "$cert"   -days "$days"   -subj "/CN=$name/O=Kagi"   -addext "subjectAltName=$san"   -addext "basicConstraints=critical,CA:FALSE"   -addext "keyUsage=critical,digitalSignature"   -addext "extendedKeyUsage=serverAuth"

chmod 0600 "$key"
chmod 0644 "$cert"
printf 'Generated ML-DSA-87 Kagi TLS identity:\n  cert: %s\n  key:  %s\n' "$cert" "$key"
printf 'Trust the certificate explicitly on Kagi peers/clients that support ML-DSA X.509.\n'
